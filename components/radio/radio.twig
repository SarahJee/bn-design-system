{#
/**
 * @file
 * BN radio. Figma: DT_Form/Radio.
 */
#}
<div{{ attributes.addClass('bn-radio') }}>
  <input class="bn-radio__input" type="radio" id="{{ id }}" name="{{ name }}" value="{{ value|default(id) }}"{% if checked %} checked{% endif %}>
  <label class="bn-radio__label" for="{{ id }}">
    <span class="bn-radio__circle" aria-hidden="true"></span>
    <span class="bn-radio__text">{{ label }}</span>
  </label>
  {% if link_text and link_url %}<a class="bn-radio__link" href="{{ link_url }}">{{ link_text }}</a>{% endif %}
</div>
